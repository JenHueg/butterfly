) +
scale_x_continuous(
labels = function(x) paste0(x, "%"),
limits = c(0, 100),
breaks = seq(0, 100, 25),
expand = c(0, 0)
) +
scale_fill_manual(
values = my_colors,
labels = c(
"1" = "1, very bad",
"2" = "2",
"3" = "3",
"4" = "4",
"5" = "5, very good"
),
name = "rating"
) +
labs(
x = NULL,
y = "percentage"
) +
theme_minimal(base_size = 16) +
theme(
legend.position = "right",
panel.grid.major.x = element_blank(),
panel.grid.minor = element_blank()
)
p
